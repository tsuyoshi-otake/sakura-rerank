+#[cfg(all(test, feature = "research-top32"))]
+mod research_tests {
+    use super::*;
+
+    #[test]
+    fn research_converter_bound_is_thirty_two() {
+        assert_eq!(MAX_CONVERSION_CANDIDATES, 32);
+    }
+
+    #[test]
+    fn segment_source_is_mapped_from_the_path_edge() {
+        let dictionary = Surface::Dictionary {
+            entry: Entry::default(),
+            entry_index: 0,
+        };
+        assert_eq!(
+            research_segment_source(dictionary),
+            ResearchSegmentSource::SystemDictionary
+        );
+        assert_eq!(
+            research_segment_source(Surface::User(0)),
+            ResearchSegmentSource::UserDictionary
+        );
+        assert_eq!(
+            research_segment_source(Surface::Reading),
+            ResearchSegmentSource::ReadingFallback
+        );
+        assert_eq!(
+            research_segment_source(Surface::Katakana),
+            ResearchSegmentSource::KatakanaFallback
+        );
+        assert_eq!(
+            research_segment_source(Surface::Literal("literal")),
+            ResearchSegmentSource::GeneratedLiteral
+        );
+    }
+
+    #[test]
+    fn search_status_strings_are_explicit() {
+        assert_eq!(
+            ResearchSearchStatus::SearchExhausted.as_str(),
+            "search_exhausted"
+        );
+        assert_eq!(ResearchSearchStatus::Truncated.as_str(), "truncated");
+    }
