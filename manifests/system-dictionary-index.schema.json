{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sakura Rerank exact system-dictionary surface index record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "surface", "readings"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "system_dictionary_surface_index"},
    "surface": {"type": "string", "minLength": 1, "maxLength": 256},
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
