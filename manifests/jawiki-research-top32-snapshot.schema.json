{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsuyoshi-otake/sakura-rerank/manifests/jawiki-research-top32-snapshot.schema.json",
  "title": "Verified jawiki research top-32 snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_kind",
    "verification_status",
    "snapshot_date",
    "source_span_extractor_git_sha",
    "source_span_content_sha256",
    "dictionary_indexer_git_sha",
    "dictionary_index_content_sha256",
    "request_builder_git_sha",
    "request_record_count",
    "request_content_sha256",
    "request_report_sha256",
    "exporter_identity_manifest_sha256",
    "exporter_git_sha",
    "exporter_binary_sha256",
    "sakura_input_head",
    "dictionary_sha256",
    "requested_limit",
    "effective_converter_bound",
    "user_dictionary_enabled",
    "record_count",
    "candidate_count",
    "search_exhausted_record_count",
    "truncated_record_count",
    "content_sha256",
    "report_sha256",
    "reproduction_run_count",
    "raw_text_in_manifest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_kind": { "const": "jawiki_research_top32_snapshot" },
    "verification_status": { "const": "verified" },
    "snapshot_date": { "const": "2026-08-01" },
    "source_span_extractor_git_sha": { "$ref": "#/$defs/gitSha" },
    "source_span_content_sha256": { "$ref": "#/$defs/sha256" },
    "dictionary_indexer_git_sha": { "$ref": "#/$defs/gitSha" },
    "dictionary_index_content_sha256": { "$ref": "#/$defs/sha256" },
    "request_builder_git_sha": { "$ref": "#/$defs/gitSha" },
    "request_record_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "request_content_sha256": { "$ref": "#/$defs/sha256" },
    "request_report_sha256": { "$ref": "#/$defs/sha256" },
    "exporter_identity_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "exporter_git_sha": { "$ref": "#/$defs/gitSha" },
    "exporter_binary_sha256": { "$ref": "#/$defs/sha256" },
    "sakura_input_head": { "$ref": "#/$defs/gitSha" },
    "dictionary_sha256": { "$ref": "#/$defs/sha256" },
    "requested_limit": { "const": 32 },
    "effective_converter_bound": { "const": 32 },
    "user_dictionary_enabled": { "const": false },
    "record_count": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "candidate_count": { "type": "integer", "minimum": 1 },
    "search_exhausted_record_count": { "type": "integer", "minimum": 0 },
    "truncated_record_count": { "type": "integer", "minimum": 0 },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "report_sha256": { "$ref": "#/$defs/sha256" },
    "reproduction_run_count": { "type": "integer", "minimum": 2 },
    "raw_text_in_manifest": { "const": false }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
