{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sakura Rerank Tier A source span",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "stable_id", "source", "committed_prefix", "gold_surface"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "jawiki_tier_a_source_span"},
    "stable_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "committed_prefix": {"type": "string", "minLength": 1, "maxLength": 4096},
    "gold_surface": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus", "snapshot_date", "article_id", "page_id", "revision_id", "paragraph_hash", "sentence_hash", "sentence_shingle_hashes", "template_cluster_id"],
      "properties": {
        "corpus": {"const": "jawiki"},
        "snapshot_date": {"const": "2026-08-01"},
        "article_id": {"type": "string"},
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "paragraph_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sentence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sentence_shingle_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "template_cluster_id": {"type": ["string", "null"]}
      }
    }
  }
}
