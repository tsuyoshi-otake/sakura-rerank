{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsuyoshi-otake/sakura-rerank/manifests/research-exporter-request-shards.schema.json",
  "title": "Research top-32 request shard manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "verification_status", "builder_git_sha", "source_span_content_sha256", "source_span_extractor_git_sha", "dictionary_index_content_sha256", "dictionary_indexer_git_sha", "dictionary_sha256", "sakura_input_head", "jawiki_local_sha256", "record_count", "shard_size", "shard_count", "content_sha256", "shards", "raw_text_in_manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "research_top32_request_shards"},
    "verification_status": {"const": "verified_inputs"},
    "builder_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_span_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_span_extractor_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dictionary_index_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dictionary_indexer_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dictionary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sakura_input_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "jawiki_local_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "shard_size": {"type": "integer", "minimum": 1, "maximum": 4096},
    "shard_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "shards": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["file_name", "record_count", "content_sha256"],
        "properties": {
          "file_name": {"type": "string", "pattern": "^requests-[0-9]{5}\\.jsonl$"},
          "record_count": {"type": "integer", "minimum": 1, "maximum": 4096},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "raw_text_in_manifest": {"const": false}
  }
}
