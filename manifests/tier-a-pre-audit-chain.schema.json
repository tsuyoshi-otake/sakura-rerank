{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tsuyoshi-otake/sakura-rerank/manifests/tier-a-pre-audit-chain.schema.json",
  "title": "Tier A v4 aggregate-only pre-audit chain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "variant", "status", "raw_text_in_manifest", "partition", "source_spans", "tier_a", "split", "human_audit"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "positiveCount": {"type": "integer", "minimum": 1, "maximum": 100000},
    "splitNames": {"type": "object", "additionalProperties": false, "required": ["train", "dev", "final_holdout"], "properties": {"train": {}, "dev": {}, "final_holdout": {}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "tier_a_pre_audit_chain"},
    "variant": {"enum": ["A", "B"]},
    "status": {"const": "pre_audit_ready"},
    "raw_text_in_manifest": {"const": false},
    "partition": {
      "type": "object", "additionalProperties": false,
      "required": ["report_sha256", "stage4_stable_id_exclusion"],
      "properties": {
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "stage4_stable_id_exclusion": {
          "type": "object", "additionalProperties": false,
          "required": ["format_version", "canonicalization", "count", "content_sha256", "raw_stable_ids_in_report"],
          "properties": {
            "format_version": {"const": 1},
            "canonicalization": {"const": "utf8_lf_sorted_unique_stable_id_jsonl_v1"},
            "count": {"$ref": "#/$defs/count"},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "raw_stable_ids_in_report": {"const": false}
          }
        }
      }
    },
    "source_spans": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "record_count", "content_sha256", "extractor_git_sha", "cleaner_version"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"}, "record_count": {"$ref": "#/$defs/positiveCount"},
        "content_sha256": {"$ref": "#/$defs/sha256"}, "extractor_git_sha": {"$ref": "#/$defs/gitSha"},
        "cleaner_version": {"const": "conservative_wikitext_v4"}
      }
    },
    "tier_a": {
      "type": "object", "additionalProperties": false,
      "required": ["report_sha256", "record_count", "content_sha256", "source_span_content_sha256"],
      "properties": {
        "report_sha256": {"$ref": "#/$defs/sha256"}, "record_count": {"$ref": "#/$defs/positiveCount"},
        "content_sha256": {"$ref": "#/$defs/sha256"}, "source_span_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["report_sha256", "seed", "ratios", "record_count", "content_sha256", "split_counts", "split_content_sha256", "near_duplicate_threshold", "cross_split_leakage_count"],
      "properties": {
        "report_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "ratios": {"allOf": [{"$ref": "#/$defs/splitNames"}], "properties": {"train": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "dev": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "final_holdout": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}},
        "record_count": {"$ref": "#/$defs/positiveCount"}, "content_sha256": {"$ref": "#/$defs/sha256"},
        "split_counts": {"allOf": [{"$ref": "#/$defs/splitNames"}], "properties": {"train": {"$ref": "#/$defs/positiveCount"}, "dev": {"$ref": "#/$defs/positiveCount"}, "final_holdout": {"$ref": "#/$defs/positiveCount"}}},
        "split_content_sha256": {"allOf": [{"$ref": "#/$defs/splitNames"}], "properties": {"train": {"$ref": "#/$defs/sha256"}, "dev": {"$ref": "#/$defs/sha256"}, "final_holdout": {"$ref": "#/$defs/sha256"}}},
        "near_duplicate_threshold": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "cross_split_leakage_count": {"const": 0}
      }
    },
    "human_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["queue_manifest_sha256", "seed", "minimum_sample_size", "dataset_record_count", "dataset_content_sha256", "queue_record_count", "final_holdout_count", "queue_content_sha256", "final_holdout_content_sha256"],
      "properties": {
        "queue_manifest_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "minimum_sample_size": {"type": "integer", "minimum": 3000, "maximum": 100000},
        "dataset_record_count": {"$ref": "#/$defs/positiveCount"}, "dataset_content_sha256": {"$ref": "#/$defs/sha256"},
        "queue_record_count": {"type": "integer", "minimum": 3000, "maximum": 100000}, "final_holdout_count": {"type": "integer", "minimum": 3000, "maximum": 100000},
        "queue_content_sha256": {"$ref": "#/$defs/sha256"}, "final_holdout_content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
