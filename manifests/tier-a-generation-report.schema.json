{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sakura Rerank Tier A generation aggregate report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_kind", "status", "input_record_count", "accepted_record_count", "rejected_record_count", "rejection_counts", "unused_exporter_snapshot_count", "jawiki_local_sha256", "jawiki_preprocessing_git_sha", "dictionary_indexer_git_sha", "source_content_sha256", "dictionary_index_content_sha256", "exporter_content_sha256", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "report_kind": {"const": "tier_a_generation"},
    "status": {"const": "generated"},
    "input_record_count": {"type": "integer", "minimum": 1},
    "accepted_record_count": {"type": "integer", "minimum": 1},
    "rejected_record_count": {"type": "integer", "minimum": 0},
    "rejection_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "unused_exporter_snapshot_count": {"type": "integer", "minimum": 0},
    "jawiki_local_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "jawiki_preprocessing_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dictionary_indexer_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dictionary_index_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exporter_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
