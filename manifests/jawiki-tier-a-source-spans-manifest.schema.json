{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sakura Rerank deterministic jawiki Tier A source-span manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "verification_status", "snapshot_date", "jawiki_local_sha256", "dictionary_index_sha256", "extractor_git_sha", "cleaner_version", "config", "eligible_dictionary_surface_count", "record_count", "content_sha256", "counts", "raw_text_in_report"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "manifest_kind": {"const": "jawiki_tier_a_source_spans"},
    "verification_status": {"enum": ["measured", "verified"]},
    "snapshot_date": {"const": "2026-08-01"},
    "jawiki_local_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dictionary_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extractor_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cleaner_version": {
      "enum": ["conservative_wikitext_v1", "conservative_wikitext_v2", "conservative_wikitext_v3", "conservative_wikitext_v4"]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_modulus", "sample_slots", "max_records", "max_records_per_page", "max_output_bytes", "min_sentence_chars", "max_sentence_chars", "min_surface_chars", "max_surface_chars"],
      "properties": {
        "sample_modulus": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "sample_slots": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "sample_slot_start": {"type": "integer", "minimum": 0, "maximum": 999999},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_records_per_page": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "min_sentence_chars": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_sentence_chars": {"type": "integer", "minimum": 1, "maximum": 4096},
        "min_surface_chars": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_surface_chars": {"type": "integer", "minimum": 1, "maximum": 256},
        "min_reading_chars": {"type": "integer", "minimum": 3, "maximum": 128},
        "max_reading_chars": {"type": "integer", "minimum": 3, "maximum": 128}
      }
    },
    "eligible_dictionary_surface_count": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "record_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 10000000000}
    },
    "raw_text_in_report": {"const": false},
    "stage4_stable_id_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format_version", "canonicalization", "count", "content_sha256", "raw_stable_ids_in_report"],
      "properties": {
        "format_version": {"const": 1},
        "canonicalization": {"const": "utf8_lf_sorted_unique_stable_id_jsonl_v1"},
        "count": {"type": "integer", "minimum": 0, "maximum": 100000},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_stable_ids_in_report": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {
        "properties": {
          "cleaner_version": {"enum": ["conservative_wikitext_v1", "conservative_wikitext_v2"]},
          "config": {
            "not": {
              "anyOf": [
                {"required": ["min_reading_chars"]},
                {"required": ["max_reading_chars"]},
                {"required": ["sample_slot_start"]}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "properties": {
          "cleaner_version": {"const": "conservative_wikitext_v3"},
          "config": {
            "allOf": [
              {"not": {"required": ["sample_slot_start"]}},
              {"required": ["min_reading_chars", "max_reading_chars"]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {
        "required": ["stage4_stable_id_exclusion"],
        "properties": {
          "cleaner_version": {"const": "conservative_wikitext_v4"},
          "config": {
            "allOf": [
              {"not": {"required": ["sample_slot_start"]}},
              {"required": ["min_reading_chars", "max_reading_chars"]}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 4}}},
      "then": {
        "required": ["stage4_stable_id_exclusion"],
        "properties": {
          "cleaner_version": {"const": "conservative_wikitext_v4"},
          "config": {"required": ["sample_slot_start", "min_reading_chars", "max_reading_chars"]}
        }
      }
    }
  ]
}
